# Copy to .env and fill in what you use.
#   cp .env.example .env
# Everything marked [REQUIRED] must be set before the site works.

# ---------- App [REQUIRED] ----------
# Public URL of the site (no trailing slash).
# Local:      http://localhost:3000
# Deployed:   https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# Create one with:  openssl rand -base64 32
NEXTAUTH_SECRET=

# ---------- Database [REQUIRED] ----------
# With docker compose (app + mongo on the same network) the default below
# already points to the mongo container — just set MONGO_USER/MONGO_PASSWORD
# here too. For MongoDB Atlas, paste your SRV string instead.
MONGODB_URI=mongodb://admin:changeme@mongo:27017
MONGODB_DB=main

# Used by docker compose to create the root user inside the mongo container.
# MONGODB_URI must contain the same user/password for authSource=admin auth.
MONGO_USER=admin
MONGO_PASSWORD=changeme

# ---------- Email ----------
# Default (zero-config): OTP emails are caught by the bundled Mailpit
# container of docker compose; read them at http://localhost:8025.

# To send real email, use Resend OR a real SMTP server.
# Resend:  set RESEND_API_KEY (resend.com, free tier works) and MAIL_FROM.
# SMTP:    set SMTP_HOST to a real server (e.g. smtp.gmail.com), SMTP_PORT
#          (587) and SMTP_USER/SMTP_PASS (Gmail: use an app password).
RESEND_API_KEY=
MAIL_FROM=

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Only used for direct TLS on port 465 (SMTP_SECURE=true); leave false otherwise.
SMTP_SECURE=false
